# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local environment files — THIS IS THE IMPORTANT ONE.
# .env.local holds your Cesium ion token. It must never be committed.
# .env.example IS committed, because it contains no real values.
.env
.env.local
.env.*.local

# Test output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Data inspection output
data-report.json

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel
